# Reown (WalletConnect) Cloud Project ID
# Get yours for free at: https://cloud.reown.com
VITE_REOWN_PROJECT_ID=your_reown_project_id_here

# Bohr Testnet RPC Endpoint
VITE_RPC_URL=https://rpc.bohr.life

# Bohr Testnet Chain ID
VITE_CHAIN_ID=968

# Deployed DocumentExpiryRegistry Smart Contract Address
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Deployer Private Key (For contract deployment scripts only)
PRIVATE_KEY=your_private_key_without_0x_prefix

